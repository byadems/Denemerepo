{% include 'header.twig' %}

    <div class="home-head">
        <div class="home-head-bg"></div>
              <div class="shapeBox">  
				<img class="shape shape1" src="../img/shape1.png" />		       
				<img class="shape shape2" src="../img/shape2.png" />		       
				<img class="shape shape3" src="../img/shape3.png" />		       
              </div>	
        <div class="home-head-content">
            <div class="container" style="position: relative;">
                <div class="row">
                    <div class="col-lg-6 col-12 d-none d-lg-block">
                        <div class="hh-left-badge">
                            <div class="hhlb-icon">
                                <i class="fas fa-crown"></i>
                            </div>
                            <div class="hhlb-text">
                                Uygun Fiyatlı ve Kaliteli Servisler
                            </div>
                        </div>
						<h1 class="hl-title">
                            Türkiye'nin En Güncel Sosyal Medya Paneli!
                        </h1>
						<div class="hl-text">
                            Tüm sosyal medya ağlarını tek panelden kaliteli ve ucuza yönetin. Günümüzün en popüler sosyal ağlarında hizmet sağlıyoruz. Instagram, Twitter, Facebook, Youtube, TikTok, Spotify ve daha bir çok servisimiz mevcuttur.
                        </div>
						<div class="hl-btns">
                            <a href="/services" class="btn btn-lg btn-outline">
                                <i class="fas fa-layer-group mr-2"></i> Tüm Servisler
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-5 offset-lg-1">
                        <div class="loginSide">
							<div class="round"></div>
                            <div class="login-box">
								  {% if errorText %}
									<div class="alert alert-dismissible alert-danger">
									  <button type="button" class="close" data-dismiss="alert">×</button>
									  {{ errorText }}
									</div>
								  {% endif %}
								  {% if successText %}
									<div class="alert alert-dismissible alert-success">
									  <button type="button" class="close" data-dismiss="alert">×</button>
									  {{ successText }}
									</div>
								  {% endif %}
                                <div class="lgb-title">
                                    Hoş geldiniz
                                </div>
                                <div class="lgb-text">
                                    Şifrenizi üçüncü kişiler ile paylaşmayınız.
                                </div>
								<form  method="post" action="">
                                <div class="fc-home">
                                    <label for="loginUsername"><span class="label-text">{{ lang['signin.username'] }}</span></label>
                                    <input type="text" id="loginUsername" name="username">
                                </div>
                                <div class="fc-home">
                                    <label for="loginPass"><span class="label-text">{{ lang['signin.password'] }}</span></label>
                                    <input type="password" id="loginPass" name="password">
                                </div>
                                <div class="form-row mt-2">
                                    <div class="col-6 py-2 mb-2">
										 <div class="form-check">
											<input type="checkbox"  name="LoginForm[remember]" value="1" id="remember">
											<label class="form-check-label" for="remember">Beni Hatırla</label>
										 </div>                                  
                                    </div>
                                    <div class="col-6 py-2 text-right">
                                        <a href="/resetpassword" class="frgpass">{{ lang['signin.password.lost'] }}</a>
                                    </div>
                                </div>
								  {% if captcha %}
									<div class="form-group">
									  <div class="g-recaptcha" data-sitekey="{{ captchaKey }}"></div>
									</div>
								  {% endif %}
                                <button class="btn btn-secondary btn-lg btn-block mt-3" type="submit">
                                    Giriş Yap
                                </button>
								</form>
                                <div class="text-center mt-4 pt-3 d-none d-md-block">
                                    <a href="/signup" class="frgpass">
                                        Henüz üye değil misin? Kayıt Ol!
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="hs-area mb-5">
        <div class="container">
            <div class="hs-head">
				<h1>Sosyal medya bizim işimiz</h1>
				<small>Bütün sosyal ağlarda en kaliteli ve uygun hizmeti sunuyoruz.</small>
			</div>
            <div class="hs-area-owl owl-carousel owl-theme">

                <div class="hsa-item item">
                    <div class="row">
                        <div class="col-auto align-self-center">
                            <div class="hsi-icon">
                                <i class="fab fa-instagram"></i>
                            </div>
                        </div>
                        <div class="col align-self-center">
                            <div class="hsi-title">
                                Instagram
                            </div>
                            <a href="/services" class="hsi-more">
                                Servisleri Gör	
                                <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </div>
                </div><!-- ./item -->


                <div class="hsa-item item">
                    <div class="row">
                        <div class="col-auto align-self-center">
                            <div class="hsi-icon">
                                <i class="fab fa-youtube"></i>
                            </div>
                        </div>
                        <div class="col align-self-center">
                            <div class="hsi-title">
                                Youtube
                            </div>
                            <a href="/services" class="hsi-more">
								Servisleri Gör	
                                <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </div>
                </div><!-- ./item -->

                <div class="hsa-item item">
                    <div class="row">
                        <div class="col-auto align-self-center">
                            <div class="hsi-icon">
                                <i class="fab fa-tiktok"></i>
                            </div>
                        </div>
                        <div class="col align-self-center">
                            <div class="hsi-title">
                                TikTok
                            </div>
                            <a href="/services" class="hsi-more">
                                Servisleri Gör
                                <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </div>
                </div><!-- ./item -->


                <div class="hsa-item item">
                    <div class="row">
                        <div class="col-auto align-self-center">
                            <div class="hsi-icon">
                                <i class="fab fa-twitter"></i>
                            </div>
                        </div>
                        <div class="col align-self-center">
                            <div class="hsi-title">
                                Twitter
                            </div>
                            <a href="/services" class="hsi-more">
								Servisleri Gör	
                                <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </div>
                </div><!-- ./item -->

                <div class="hsa-item item">
                    <div class="row">
                        <div class="col-auto align-self-center">
                            <div class="hsi-icon">
                                <i class="fab fa-facebook-square"></i>
                            </div>
                        </div>
                        <div class="col align-self-center">
                            <div class="hsi-title">
                                Facebook
                            </div>
                            <a href="/services" class="hsi-more">
                                Servisleri Gör
                                <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </div>
                </div><!-- ./item -->


            </div>
        </div>
    </div>


		<section class="hs-about mt-3 mb-5">
            <div class="ha-item">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12 mr-auto">
                            <div class="row">
                                <div class="col-lg-5 ha-heading">
									<div class="ha-title">
										<div class="row">
											<div class="col-md-auto col-12 align-self-center">
												<div class="ha-title-icon">
													<i class="fal fa-badge-check"></i>
												</div>
											</div>
											<div class="col-md col-12 align-self-center">
												<h2>
													Uygun fiyat ve hızlı teslimat garantisi!
												</h2>
											</div>
										</div>
										<div class="ha-text">
											En eski ve en güvenilir otomatik sosyal medya hizmetleri sağlayan bir paneldir. Fenomensen tam otomatik çalışan bir sistemdir ve şifrenizi paylaşmadan takipçi, beğeni, izlenme ve daha fazlasını alabileceğiniz bir yapıya sahiptir.
										</div>
										<a href="/services" class="btn btn-primary mt-4">
											Servis Listesi
										</a>										
										<a href="/signup" class="btn btn-secondary mt-4 ml-2">
											Ücretsiz Kayıt Ol
										</a>
									</div>
									
                                </div>
                                <div class="col-lg-6 ha-graph">
                                    <div class="graphics">
