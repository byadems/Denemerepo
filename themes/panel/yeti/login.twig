	<section class="footer mt-5">
            <div class="footer-top">
				<div class="container">
					<div class="row">
						<div class="col-lg-12 col-12 mt-4 mt-lg-0 align-self-center add-left-border text-lg-center">
							<div class="ftgu-text">
