{% include 'header.twig' %}

      <div class="panel-main togg">
         <div class="container">
            <div class="row">
               <div class="col-lg-12">
                  <div class="well yellow mb-3 pb-0 pt-2">
                    <div class="row">
						<div class="col-3 d-none d-md-block">
							<img src="images/galaxy/jwc80u0sdszrwiz2.png" />
						</div>
						<div class="col-md-9 col-12">
							<div class="headText mt-4 mb-2">
								<h1>Merhaba <span>@{{user['username']}}!</span></h1>
								<p><span>{{ site['site_name'] }}</span>’a hoşgeldin. Bu sayfa da yeni bir sipariş oluşturabilir, veya şuan’a kadar yapmış olduğun toplam işlemleri görebilirsin. Herhangi bir sorun olursa aşağıda ki butona tıklayarak bizlere ulaşabilirsin, sana yardımcı olmayı çok isteriz!</p>
								<a href="/tickets"><button type="button" class="btn btn-orange btn-block mt-4" style="max-width: 250px"><i class="fas fa-user-headset"></i> Destek Talebi</button></a>
							</div>
						</div>
					</div>
                  </div>
               </div>

               <div class="col-lg-8 mt-4">
                  <div class="well green">
						<div class="widget-head">
							<h1>Sipariş Oluştur</h1>
                            <img src="images/galaxy/98s33dc99zbbd1kw.png" class="well-icon" alt="">
                        </div>
						
					  <form method="post" action="/">
							{% if error %}
							  <div class="alert alert-dismissible alert-danger">
								{{ errorText }}
							  </div>
							{% endif %}

							{% if data["order"]["success"] == 1 %}
							  <div class="alert alert-dismissible alert-success">
								  <strong> {{ lang["neworder.success.id"] }}: </strong> {{ data['order']['id'] }} <br>
								  <strong> {{ lang["neworder.success.service"] }}: </strong> {{ data['order']['service'] }} <br>
								  <strong> {{ lang["neworder.success.link"] }}: </strong> {{ data['order']['link'] }} <br>
								  <strong> {{ lang["neworder.success.quantity"] }}: </strong> {{ data['order']['quantity'] }} <br>
								  <strong> {{ lang["neworder.success.link"] }}: </strong> {{ data['order']['price'] }} <br>
								  <strong> {{ lang["neworder.success.balance"] }}: </strong>{{ data['order']['balance'] }} <br>
							  </div>
							{% endif %}
							{% if data["order"]["success"] == 2 %}
							  <div class="alert alert-dismissible alert-success">
								 <strong> {{ lang["neworder.success.id"] }}: </strong> {{ data['order']['id'] }} <br>
								 <strong> {{ lang["neworder.success.service"] }}: </strong> {{ data['order']['service'] }} <br>
								 <strong> {{ lang["neworder.success.username"] }}: </strong> {{ data['order']['link'] }} <br>
								 <strong> {{ lang["neworder.success.quantity"] }}: </strong> {{ data['order']['min'] }} - {{ data['order']['max'] }} <br>
								 <strong> {{ lang["neworder.success.posts"] }}: </strong> {{ data['order']['posts'] }} <br>
								 <strong> {{ lang["neworder.success.delay"] }}: </strong>{{ data['order']['delay'] }} <br>
							   </div>
							{% endif %}
					  
						{% if categories %}
						 <div class="form-group">
							<label for="orderform-category" class="control-label">Kategori</label>
							<select class="form-control" id="neworder_category" name="categories" style="display:none">
							{% for category in categories %}
								<option value="{{ category["category_id"] }}" >{{ category["category_name"] }}</option>
							{% endfor %}
							</select>
							  <div class="dropdown">
								<button class="form-control text-left" type="button" id="dropdownMenu3" data-toggle="dropdown" aria-haspopup="false" aria-expanded="false">
									<span id="categoryTitle"></span>
									<i class="fa fa-caret-down pull-right" style="float:right" aria-hidden="true"></i>
								</button>
								<div class="dropdown-menu" aria-labelledby="dropdownMenu2" id="category-drop">
								</div>
							  </div>
						 </div>
						{% endif %}
						 
                    <div class="form-group">
                        <label id="orderform-service" for="orderform-service" class="control-label" data-label="{{ lang["neworder.service"] }}">Servis</label>

                        <select class="form-control" id="neworder_services" name="services">
                        </select>
                    </div>
						 
							<div id="neworder_fields"></div>

							  <div class="form-group mt-2" id="charge_div">
								<label class="control-label" for="field-orderform-fields-quantity">Tutar</label>
									<input type="text" class="form-control" id="charge" readonly>
							  </div>
							  
						{% if neworderTerms %}
						  <div class="checkbox">
							<label>
							  <input type="checkbox" name="neworder_check">{{ lang['neworder.recheck'] }}
							</label>
						  </div>
						{% endif %}
						
						 <button type="submit" class="btn btn-green btn-block" style="max-width:500px; margin: auto"><i class="fas fa-plus"></i> Sipariş ver</button>
					  </form>
						<a href="/addfunds"><button type="button" class="btn btn-orange btn-block mt-4" style="max-width:500px; margin: auto"><i class="fas fa-wallet"></i> Bakiye Yükle</button></a>
                  </div>
               </div>

               <div class="col-lg-4 mt-4">
                  <div class="well yellow mb-3 pb-2 pt-3">
                    <div class="widBox">
						<i class="far fa-wallet mb-3"></i>
						<h1>Güncel Bakiye</h1>
						<p class="mt-4">{{ user['balance'] }}</p>
					</div>	
                  </div>
                  <div class="well blue mb-3 pb-2 pt-3">
                    <div class="widBox">
						<i class="fal fa-hand-holding-usd mb-3"></i>
						<h1>Toplam Harcanan</h1>
						<p class="mt-4">{{ user['spent'] }}</p>
					</div>
                  </div>
                  <div class="well red mb-3 pb-2 pt-3">
                    <div class="widBox">
						<i class="far fa-shopping-basket mb-3"></i>
						<h1>Toplam Sipariş</h1>
						<p class="mt-4">{{ ordersCount }}</p>
					</div>
                  </div>
               </div>

			   
            </div>
         </div>
      </div>

{% include 'footer.twig' %}
