{% include 'header.twig' %}
  <div class="main-header">
         <div class="main-header-bg">
            <div class="mh-img"></div>
         </div>
         <div class="mh-content">
            <div class="container">
               <div class="row">
                  <div class="col-lg-6 col-12 d-none d-md-block">

                  <div id="topSlider" class="owl-carousel owl-theme sliders">
                     <div class="item hc-item">
                        <div class="hc-title">
                           <div class="row">
                              <div class="col-8">
								<h1>Türkiye'nin #1 Numaralı<br /><span>SMM Paneline Hoşgeldiniz</span></h1>
								<div class="d-flex align-items-center mb-4 mt-4 pl-3">
									<div class="d-flex align-items-center mr-4">
										<img src="https://cdn.mypanel.link/n3e4wz/7c667xee5rqanurd.png" class="pr-3" />
										<span class="counts"><em>+526</em><br />Mutlu Müşteri</span>
									</div>
									<div class="d-flex align-items-center">
										<img src="https://cdn.mypanel.link/n3e4wz/l2duig2c2x1dietm.png" class="pr-3" />
										<span class="counts"><em>+{{ ordersCount }}</em><br />Başarılı Sipariş</span>
									</div>
								</div>
								<p>Hemen kayıt olarak sipariş verebilir, hesabınızın etkileşimini hızlıca yükseltebilirsiniz.</p>
                                <a href="/signup"><button type="button" class="btn btn-red btn-block mt-2">Hadi Başlayalım <i class="fas fa-long-arrow-alt-right"></i></button></a>
                              </div>
							  <div class="col-4 slide-img">
									<img src="https://cdn.mypanel.link/n3e4wz/wi1lqx2maue1uhsf.png" />
							  </div>
                           </div>
                        </div>
                     </div>
                     <div class="item hc-item">
                        <div class="hc-title">
                           <div class="row">
                              <div class="col-8">
								<h1>Türkiye'nin #1 Numaralı<br /><span>SMM Paneline Hoşgeldiniz</span></h1>
								<div class="d-flex align-items-center mb-4 mt-4 pl-3">
									<div class="d-flex align-items-center mr-4">
										<img src="https://cdn.mypanel.link/n3e4wz/7c667xee5rqanurd.png" class="pr-3" />
										<span class="counts"><em>+264</em><br />Mutlu Müşteri</span>
									</div>
									<div class="d-flex align-items-center">
										<img src="https://cdn.mypanel.link/n3e4wz/l2duig2c2x1dietm.png" class="pr-3" />
										<span class="counts"><em>+{{ ordersCount }}</em><br />Başarılı Sipariş</span>
									</div>
								</div>
								<p>Hemen kayıt olarak sipariş verebilir, hesabınızın etkileşimini hızlıca yükseltebilirsiniz.</p>
                                <a href="/signup"><button type="button" class="btn btn-red btn-block mt-2">Hadi Başlayalım <i class="fas fa-long-arrow-alt-right"></i></button></a>
                              </div>
							  <div class="col-4 slide-img">
									<img src="https://cdn.mypanel.link/n3e4wz/wi1lqx2maue1uhsf.png" />
							  </div>
                           </div>
                        </div>
                     </div>
                  </div>

                  <div id="socialSlider" class="owl-carousel owl-theme sSlide">
                     <div class="item hc-item">
                        <div class="hc-title">
                           <div class="row">
                              <div class="col hc-text align-self-center">
                                 <i class="fab fa-instagram"></i>
								 <p class="mt-3">Instagram Hizmetleri</p>
                              </div>
                              <div class="col hc-text align-self-center">
                                 <i class="fab fa-facebook-square"></i>
								 <p class="mt-3">Facebook Hizmetleri</p>
                              </div>
                              <div class="col hc-text align-self-center">
                                 <i class="fab fa-twitter"></i>
								 <p class="mt-3">Twitter Hizmetleri</p>
                              </div>
                              <div class="col hc-text align-self-center">
                                 <i class="fab fa-youtube"></i>
								 <p class="mt-3">Youtube Hizmetleri</p>
                              </div>							  
                           </div>
                        </div>
                     </div>
                     <div class="item hc-item">
                        <div class="hc-title">
                           <div class="row">
                              <div class="col hc-text align-self-center">
                                 <i class="fab fa-tiktok"></i>
								 <p class="mt-3">Tiktok Hizmetleri</p>
                              </div>
                              <div class="col hc-text align-self-center">
                                 <i class="fab fa-twitch"></i>
								 <p class="mt-3">Twitch Hizmetleri</p>
                              </div>
                              <div class="col hc-text align-self-center">
                                 <i class="fab fa-telegram-plane"></i>
								 <p class="mt-3">Telegram Hizmetleri</p>
                              </div>
                              <div class="col hc-text align-self-center">
                                 <i class="fab fa-soundcloud"></i>
								 <p class="mt-3">SoundCloud Hizmetleri</p>
                              </div>
                           </div>
                        </div>
                     </div>
                  </div>

                  </div>
                  <div class="col-lg-5 offset-lg-1 col-12 mt-5 mt-lg-0">
                     <div class="loginSide">
                        <h1 class="sWhite text-center">Hoşgeldiniz</h1>
                        <form  method="post" action="">
						  {% if errorText %}
							<div class="alert alert-dismissible alert-danger">
							  <button type="button" class="close" data-dismiss="alert">×</button>
							  {{ errorText }}
							</div>
						  {% endif %}
						  {% if successText %}
							<div class="alert alert-dismissible alert-success">
							  <button type="button" class="close" data-dismiss="alert">×</button>
							  {{ successText }}
							</div>
						  {% endif %}
                           <div class="form-group formIcon">
                              <i class="fal fa-user icon"></i>
                              <input type="text" class="form-control" id="username" placeholder="Kullanıcı Adınız" name="username">
                           </div>
                           <div class="form-group fg-pass formIcon">
                             <i class="fal fa-lock-alt icon"></i>
                              <input type="password" class="form-control" id="password" placeholder="Şifreniz" name="password">
                           </div>
          {% if captcha %}
            <div class="form-group">
              <div class="g-recaptcha" data-sitekey="{{ captchaKey }}"></div>
            </div>
          {% endif %}
                           <div class="form-group mt-5">
                              <button type="submit" class="btn btn-green btn-block"><i class="fal fa-sign-in"></i> Giriş Yap</button>
                           </div>
							<div class="row mt-4 mb-5">
							   <div class="col-md col-12 text-center text-md-left">
								  <span class="home-login-alt-text">
                                    <span class="check btn-check">
                                    <input name="remember" value="1" type="checkbox" id="check" />
                                    <label for="check"/>
                                    </span>
                                    <label class="rememberme" for="check" >Beni hatırla</label>
								  </span>
							   </div>
							   <div class="col-md col-12 text-center text-md-right">
								  <span class="home-login-alt-text">
								  <a href="/resetpassword">Parolanızı mı unuttunuz?</a>
								  </span>
							   </div>
							</div>
                           <div class="form-group mt-5">
                             <a href="/signup" style="width:100%"><button type="button" class="btn btn-orange btn-block"><i class="fas fa-arrow-circle-right"></i> Kayıt Ol</button></a>
                           </div>
                        </form>
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>

