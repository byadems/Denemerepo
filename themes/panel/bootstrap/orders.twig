{% include 'header.twig' %}

<div class="panel-main togg">

<div class="container-fluid">
  <div class="row">
    <div class="col-lg-12">
      <div class="head-txt text-center mt-5 mb-5">
        <h1>Siparişlerim</h1>
        <img  class="mb-3" src="images/galaxy/ztiunwaw01s94gb9.png" />
      </div>
      <div class="well yellow well-float">
        
        <div class="srv-search mb-3">
           <form action="{{ page['url'] }}" method="get" id="history-search">
              <input type="text" name="search" id="serv-inp" class="srv-input services-filter" placeholder="Sipariş Ara.." value="{{ search }}">
              <button type="submit" class="srv-submit">
                 <i class="fas fa-search"></i>
              </button>
           </form>
        </div>
        
      <ul class="nav nav-pills servNav mb-4 {% if site['rtl'] %} rtl-nav {% endif %}">
        <li {% if 'all' == status %}  class="active" {% endif %}><a href="orders"><i class="fas fa-shopping-basket"></i> {{ lang['orders.status.all'] }}</a></li>
        <li {% if 'pending' == status %}  class="active" {% endif %}><a href="orders/pending"><i class="fas fa-box-check"></i> {{ lang['orders.status.pending'] }}</a></li>
        <li {% if 'inprogress' == status %}  class="active" {% endif %}><a href="orders/inprogress"><i class="fas fa-spinner"></i> {{ lang['orders.status.inprogress'] }}</a></li>
        <li {% if 'completed' == status %}  class="active" {% endif %}><a href="orders/completed"><i class="fas fa-check"></i> {{ lang['orders.status.completed'] }}</a></li>
        <li {% if 'partial' == status %}  class="active" {% endif %}><a href="orders/partial"><i class="fas fa-battery-half"></i> {{ lang['orders.status.partial'] }}</a></li>
        <li {% if 'processing' == status %}  class="active" {% endif %}><a href="orders/processing"><i class="fas fa-sort-size-up-alt"></i> {{ lang['orders.status.processing'] }}</a></li>
        <li {% if 'canceled' == status %}  class="active" {% endif %}><a href="orders/canceled"><i class="fas fa-ban"></i> {{ lang['orders.status.canceled'] }}</a></li>
      </ul>   
        <table id="serv-table" class="table {% if site['rtl'] %} rtl-table {% endif %}">
          <thead>
          <tr>
            <th>{{ lang['orders.id'] }}</th>
            <th>{{ lang['orders.date'] }}</th>
            <th class="width-40">{{ lang['orders.link'] }}</th>
            <th>{{ lang['orders.charge'] }}</th>
            <th class="nowrap">{{ lang['orders.start.count'] }}</th>
            <th>{{ lang['orders.quantity'] }}</th>
            <th>{{ lang['orders.service'] }}</th>
            <th>{{ lang['orders.remains'] }}</th>
            <th style="width:10%">{{ lang['orders.status'] }}</th>
            <th></th>
            <th></th>
          </tr>
          </thead>
          <tbody>
          {% for order in orders %}
            <tr>
              <td data-label="Sipariş No">{{ order['id'] }}</td>
              <td data-label="Tarih ve Saat">{{ order['date'] }}</td>
              <td class="width-30"><a target="_blank" style="font-weight: 500;" href="{{ order['link'] }}"><i class="fa fa-link"></i> {{ order['link'] }}</a></td>
              <td data-label="Ücret">{{ order['charge'] }}</td>
              <td data-label="Başlangıç" class="nowrap">{{ order['start_count'] }}</td>
              <td data-label="Miktar">{{ order['quantity'] }}</td>
              <td data-label="Servis">{{ order['service'] }}</td>
              <td data-label="Kalan">{{ order['remains'] }}</td>
              <td data-label="Durum">
                  {% if order['status'] == 'Tamamlandı' %}
                  <span style="color: #00b97d">Tamamlandı</span>
                	{% endif %}
                  {% if order['status'] == 'Yükleniyor' %}
                  <span style="color: #ff3950">Yükleniyor</span>
                	{% endif %}
		          {% if order['status'] == 'Sipariş Alındı' %}
                  <span style="color: #ec4acc">Sipariş Alındı</span>
                	{% endif %}
                 {% if order['status'] == 'Kısmen Tamamlandı (Kalan Tutar İade Edildi)' %}
                  <span style="color: #3e4a8f">Kısmi Tamamlandı</span>
                	{% endif %}
                 {% if order['status'] == 'Gönderim Sırasında' %}
                  <span style="color: #eebb0b">Gönderim Sırasında</span>
                	{% endif %}
                 {% if order['status'] == 'İptal Edildi' %}
                  <span style="color: #ff3651">İptal edildi</span>
              	 {% endif %}
              </td>
                <td>
                  {% if order['refillButton'] %}
                   <div class="order-actions">
                    <a href="/orders/refill/{{ order['id'] }}" class="btn btn-xs btn-primary">{{ lang['orders.button.refill'] }}</a>
                   </div> 
                  {% endif %}                
                </td>
                <td>
                  {% if order['cancelButton'] %}
                   <div class="order-actions">
                    <a href="/orders/cancel/{{ order['id'] }}" class="btn btn-xs btn-primary">{{ lang['orders.button.cancel'] }}</a> 
                   </div> 
                  {% endif %}
                </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>

      {% if pagination["count"] > 1 %}
        <ul class="pagination">

          {% if pagination["current"] != 1 %}
            <li>
              <a href="orders/{{ status }}/{{ pagination["previous"] }}{% if search %}?search={{ search }}{% endif %}" aria-label="Previous">
                <span aria-hidden="true">«</span>
              </a>
            </li>
          {% endif %}

          {% set r, l = 3, 3 %}

          {% if pagination['current'] == 1 %}
            {% set r = 7 %}
          {% endif %}

          {% if pagination['current'] == 2 %}
            {% set r = 5 %}
          {% endif %}

          {% if pagination['current'] >= pagination['count'] %}
            {% set l = 5 %}
          {% endif %}

          {% for page in 1..pagination["count"] %}
            {% if page >= (pagination['current']-l) and page <= (pagination['current']+r) %}
              <li{% if page == pagination['current'] %} class="active" {%endif%}><a href="orders/{{ status }}/{{ page }}{% if search %}?search={{ search }}{% endif %}">{{ page }}</a></li>
            {%endif%}
          {% endfor %}

          {% if pagination['current'] < pagination['count'] %}
            <li>
              <a href="orders/{{ status }}/{{ pagination['next'] }}{% if search %}?search={{ search }}{% endif %}" aria-label="Next">
                <span aria-hidden="true">»</span>
              </a>
            </li>
          {% endif %}

        </ul>
      {% endif %}

    </div>
  </div>
</div>
  
  
</div>

{% include 'footer.twig' %}