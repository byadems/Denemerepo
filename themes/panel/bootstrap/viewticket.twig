{% include 'header.twig' %}

<div class="panel-main togg">

<div class="container">
      <div class="head-txt text-center mt-5 mb-5">
        <h1>Destek Merkezi</h1>
        <img  class="mb-3" src="images/galaxy/ztiunwaw01s94gb9.png" />
      </div>
  <div class="row">
    <div class="col-md-10 offset-md-1">
      {% if error %}
        <div class="alert alert-dismissible alert-danger">
          <button type="button" class="close" data-dismiss="alert">×</button>
          {{ errorText }}
        </div>
      {% endif %}
      {% if success %}
        <div class="alert alert-dismissible alert-success">
          <button type="button" class="close" data-dismiss="alert">×</button>
          {{ successText }}
        </div>
      {% endif %}
      <div class="well green">
        <div class="ticket-title mb-3"><span>Konu:</span> {{ messageList['ticket']['subject'] }} {% if messageList["ticket"]["canmessage"] == 1 %} <span class="badge"> bu talebiniz yönetici tarafından kapanmış</span> {% endif %}</div>
              {% if messageList %}
                {% for message in messageList %}
                  {% if message["support"] == 1 %}
                    <div class="row ticket-message-block ticket-message-right">
                      <div class="col-md-1"></div>
                      <div class="col-md-11">
                        <div class="ticket-message">
                          <div class="message">{{ message["message"] }}</div>
                        </div>
                        <div class="info text-right">
                          <strong>{{ user["username"] }}</strong>
                          <small class="text-muted">{{ message["time"] }}</small>
                        </div>
                      </div>
                      <div class="col-md-1"></div>
                    </div>
                  {% elseif message["subject"] %}
                  {% else %}
                    <div class="row ticket-message-block ticket-message-left">
                      <div class="col-md-11">
                        <div class="ticket-message">
                          <div class="message">{{ message["message"] }}</div>
                        </div>
                        <div class="info">
                          <strong>Destek yöneticisi</strong>
                          <small class="text-muted">{{ message["time"] }}</small>
                        </div>
                      </div>
                      <div class="col-md-1"></div>
                    </div>
                  {% endif %}

                {% endfor %}
              {% endif %}
            {% if messageList['ticket']['canmessage'] == 2 %}
              <div class="row">
                  <div class="col-md-12">
                    <form method="post" action="tickets/{{ messageList['ticket']['ticket_id'] }}">
                      <div class="form-group panel-border-top">
                        <label for="message" class="control-label">Mesajınız</label>
                        <textarea id="message" rows="5" class="form-control" name="message">{{ data["message"] }}</textarea>
                      </div>
                      <button type="submit" class="btn btn-green"><i class="fas fa-paper-plane"></i> Cevapla</button>
                    </form>
                  </div>
                </div>
              </div>
            {% endif %}
      </div>
    </div>
  </div>
</div>
  
</div>
{% include 'footer.twig' %}
